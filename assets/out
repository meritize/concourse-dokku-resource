#!/usr/bin/osh
# vim: set ft=sh

set -e

shopt --set parse_at parse_brace parse_paren parse_proc

exec 3>&1 # make stdout available as fd 3 for the result
exec 1>&2 # redirect all output to stderr for logging

source $(dirname $0)/common.sh

source=$1

if [ -z "$source" ]; then
  echo "usage: $0 <path/to/source>"
  exit 1
fi

# for jq
PATH=/usr/local/bin:$PATH

payload="$(cat <&0)"

load_pubkey "$payload"
configure_https_tunnel "$payload"
configure_submodule_credentials "$payload"

json read (&config) <<< "$payload"

setvar config["source"] = config["source"] or {}

var server = get(config["source"], "server", "")
var branch = get(config["source"], "branch", "")
var git_config_payload = get(config["source"], "git_config", [])
var repository = get(config["params"], "repository", "")
var app = get(config["params"], "app", "")
var dockerfile_path = get(config["params"], "dockerfile_path", "")
var app_json_path = get(config["params"], "app_json_path", "")
var override_branch = get(config["params"], "branch", "")
var override_builder = get(config["params"], "builder", "")
var tls_key = get(get(config["params"], "tls", {}), "key", "")
var tls_cert = get(get(config["params"], "tls", {}), "cert", "")
var app_domains = get(config["params"], "domains", [])
var environment = get(config["params"], "environment_variables", {})
var environment_from_files = get(config["params"], "environment_from_files", {})

builder=$override_builder

for element in (git_config_payload) {
  git config --global $[element['name']] $[element['value']]
}

if [ -z "$server" ]; then
  echo "invalid payload (missing server)"
  exit 1
fi

if [ -z "$app" ]; then
  echo "invalid payload (missing app)"
  exit 1
fi

for domain in (app_domains) {
  if (domain.search(/![ a-z A-Z '-' '.' ]/)) {
    echo "ERROR! Invalid characters in domain name - $domain"
    exit 1
  }
}

uri="ssh://dokku@$server/$app"
server_host=$(echo "$server:" | cut -d ':' -f1)
server_port=$(echo "$server:" | cut -d ':' -f2)
server_port=${server_port:-22}

var ext_commands = []
proc mockcommand(...args) {
  call ext_commands->append(args)
}

if [ "$TEST_MOCK_EXT" = "1" ]
then
  EXTCMD="mockcommand"
  touch $TMPDIR/extcommand2.log
else
  EXTCMD=""
fi

dokku_cmd() {
  local -r port=${server_port-22}
  $EXTCMD ssh "dokku@$server_host" -p "$port" "$@"
}

if [ -z "$branch" ] && [ -z "$override_branch" ]; then
  echo "invalid payload (missing branch)"
  exit 1
fi

if [ -z "$repository" ]; then
  echo "invalid payload (missing repository)"
  exit 1
fi

if [ -n "$override_branch" ]; then
  echo "Override $branch with $override_branch"
  branch=$override_branch
fi

cd "$source"
cd "$repository" # these are separate commands is because the tests use an absolute path for repository

if ! dokku_cmd apps:exists "$app"
then
  echo "App $app does not exist, creating it"
  dokku_cmd apps:create "$app"
fi

if [ -n "$builder" ]; then
  echo "Using builder $builder"
  dokku_cmd builder:set "$app" selected "$builder"
fi

echo "Setting app configuration.  Hiding output to protect any secrets."

var all_environment = dict(environment)
for key, filename in (environment_from_files) {
  setvar all_environment[key] = $(< $filename).trim()
}

# unset only the variables we've previously set.  We don't want to wipe out GIT_REV, for example.
# passing _CONCOURSE_EXISTING_VARS_ as the last arg also stops this command from failing on the first time we deploy the app.
dokku_cmd config:unset --no-restart "$app" $(dokku_cmd config:get "$app" "_CONCOURSE_EXISTING_VARS_") _CONCOURSE_EXISTING_VARS_

setvar all_environment["_CONCOURSE_EXISTING_VARS_"] = join(keys(all_environment), " ")
var encoded_env = []
for key, value in (all_environment) {
  call encoded_env->append(key ++ '=' ++ $(printf %s "$value" | base64))
  = encoded_env
}
dokku_cmd config:set --encoded --no-restart "$app" @encoded_env > /dev/null

if (len(app_domains) > 0) {
  echo "Setting up App Domains"

  echo @app_domains
  dokku_cmd domains:set "$app" @app_domains
}

if [ -n "$dockerfile_path" ]
then
  dokku_cmd builder-dockerfile:set "$app" dockerfile-path "$dockerfile_path"
fi
if [ -n "$app_json_path" ]
then
  dokku_cmd app-json:set "$app" appjson-path "$app_json_path"
fi

deployed_commit=$($EXTCMD git ls-remote "$uri" refs/heads/$branch | awk '{print $1}')
local_head=$(git rev-parse HEAD)

echo "Currently deployed commit is $deployed_commit"
echo "Local HEAD is $local_head"

# if the ref is the same, dokku won't rebuild.
if [ "$deployed_commit" != "$local_head" ]; then
  echo "Pushing $branch to refs/heads/master on $uri"
  $EXTCMD git push --force "$uri" HEAD:refs/heads/$branch
else
  echo "Dokku remote is up to date.  Forcing a rebuild of app instead of pushing."
  dokku_cmd ps:rebuild "$app"
fi

if [ -n "$tls_cert" ]
then
  echo "Setting up TLS certificates using provided certificate and key."
  tempdir=$(mktemp -d)
  certfile=$tempdir/tls.crt
  keyfile=$tempdir/tls.key
  printf "%s\n" "$tls_cert" > "$certfile"
  printf "%s\n" "$tls_key" > "$keyfile"
  tar -C "$tempdir" -c "tls.crt" "tls.key" | dokku_cmd certs:add "$app"
fi


var version_info = {
  "ref": $(git rev-parse HEAD)
}

if [ -n "$override_branch" ] {
  setvar version_info['branch'] = override_branch
}

var output = {
  'version': version_info,
  'metadata': git_metadata(),
}

json write (output) >&3

if [ "$TEST_MOCK_EXT" = "1" ]
then
  json write (ext_commands) > $TMPDIR/extcommand.json
fi
